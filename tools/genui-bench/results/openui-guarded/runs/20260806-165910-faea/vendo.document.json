{
  "format": "vendo/app@1",
  "name": "Recent Transactions",
  "tree": {
    "formatVersion": "vendo-genui/v2",
    "root": "root",
    "nodes": [
      {
        "id": "root",
        "component": "Stack",
        "source": "prewired",
        "children": [
          "group-0"
        ]
      },
      {
        "id": "group-0",
        "component": "Surface",
        "source": "prewired",
        "children": [
          "stat-1",
          "group-0-title",
          "group-0-body"
        ]
      },
      {
        "id": "stat-1",
        "component": "Stat",
        "source": "prewired",
        "props": {
          "label": "Total Balance",
          "value": {
            "$path": "/accounts",
            "$reshape": [
              {
                "op": "sum",
                "args": [
                  "balance"
                ]
              }
            ]
          },
          "format": "money"
        }
      },
      {
        "id": "group-0-title",
        "component": "Text",
        "source": "prewired",
        "props": {
          "text": "Recent Activity",
          "variant": "heading"
        }
      },
      {
        "id": "group-0-body",
        "component": "Stack",
        "source": "prewired",
        "children": [
          "maplespendingdonut-1"
        ]
      },
      {
        "id": "maplespendingdonut-1",
        "component": "MapleSpendingDonut",
        "source": "host",
        "props": {
          "data": {
            "$path": "/transactions/data"
          }
        }
      }
    ],
    "queries": [
      {
        "name": "transactions",
        "tool": "host_listTransactions",
        "input": {
          "limit": 20
        }
      },
      {
        "name": "accounts",
        "tool": "host_listAccounts"
      }
    ]
  },
  "id": "app_bench_mshfnoyf"
}
