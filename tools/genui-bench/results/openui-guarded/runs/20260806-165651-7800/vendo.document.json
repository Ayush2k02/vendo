{
  "format": "vendo/app@1",
  "name": "Deadline Board",
  "tree": {
    "formatVersion": "vendo-genui/v2",
    "root": "app",
    "nodes": [
      {
        "id": "app",
        "component": "Stack",
        "source": "prewired",
        "children": [
          "tabs"
        ]
      },
      {
        "id": "tabs",
        "component": "Tabs",
        "source": "prewired",
        "props": {
          "tabs": [
            {
              "value": "30-Day View",
              "label": "30-Day View"
            },
            {
              "value": "Activity Feed",
              "label": "Activity Feed"
            }
          ],
          "value": "30-Day View"
        },
        "children": [
          "tab-0",
          "tab-1"
        ]
      },
      {
        "id": "tab-0",
        "component": "Stack",
        "source": "prewired",
        "children": [
          "group-0"
        ]
      },
      {
        "id": "tab-1",
        "component": "Stack",
        "source": "prewired",
        "children": [
          "group-1"
        ]
      },
      {
        "id": "group-0",
        "component": "Surface",
        "source": "prewired",
        "children": [
          "group-0-title",
          "group-0-body"
        ]
      },
      {
        "id": "group-0-title",
        "component": "Text",
        "source": "prewired",
        "props": {
          "text": "Deadlines & Progress",
          "variant": "heading"
        }
      },
      {
        "id": "group-0-body",
        "component": "Grid",
        "source": "prewired",
        "props": {
          "columns": 2
        },
        "children": [
          "group-0-body-cadencemissingdocshero-1",
          "group-0-body-datatable-1"
        ]
      },
      {
        "id": "group-0-body-cadencemissingdocshero-1",
        "component": "CadenceMissingDocsHero",
        "source": "host",
        "props": {
          "missingCount": {
            "$path": "/dashboard/clientsMissingDocs"
          },
          "clientCount": {
            "$path": "/dashboard/clientsTotal"
          },
          "badgeLabel": "Pending Documents"
        }
      },
      {
        "id": "group-0-body-datatable-1",
        "component": "DataTable",
        "source": "prewired",
        "props": {
          "rows": {
            "$path": "/deadlines"
          },
          "sortBy": "filingDeadline asc",
          "columns": [
            {
              "key": "businessName",
              "label": "Business Name"
            },
            {
              "key": "entityType",
              "label": "Entity Type"
            },
            {
              "key": "filingDeadline",
              "label": "Filing Deadline",
              "format": "date"
            },
            {
              "key": "status",
              "label": "Status"
            },
            {
              "key": "missingDocKinds",
              "label": "Missing Document Categories"
            },
            {
              "key": "assignee.name",
              "label": "Assignee"
            }
          ],
          "emptyState": "No filing deadlines found between August 6, 2026 and September 5, 2026"
        }
      },
      {
        "id": "group-1",
        "component": "Surface",
        "source": "prewired",
        "children": [
          "group-1-title",
          "group-1-body"
        ]
      },
      {
        "id": "group-1-title",
        "component": "Text",
        "source": "prewired",
        "props": {
          "text": "Deadline Activity Log",
          "variant": "heading"
        }
      },
      {
        "id": "group-1-body",
        "component": "Stack",
        "source": "prewired",
        "children": [
          "group-1-body-datatable-1"
        ]
      },
      {
        "id": "group-1-body-datatable-1",
        "component": "DataTable",
        "source": "prewired",
        "props": {
          "rows": {
            "$path": "/hostListActivity"
          },
          "columns": [
            {
              "key": "at",
              "label": "Timestamp",
              "format": "datetime"
            },
            {
              "key": "type",
              "label": "Event Type"
            },
            {
              "key": "summary",
              "label": "Summary"
            },
            {
              "key": "clientId",
              "label": "Client ID"
            }
          ],
          "sortBy": "at desc",
          "filterableBy": [
            "type"
          ],
          "searchable": true,
          "paginate": 10,
          "emptyState": "No recent activity logged",
          "caption": "Recent uploads, document verifications, and deadline warnings"
        }
      }
    ],
    "queries": [
      {
        "name": "deadlines",
        "tool": "host_listDeadlines",
        "input": {}
      },
      {
        "name": "dashboard",
        "tool": "host_getDashboard",
        "input": {}
      },
      {
        "name": "activity",
        "tool": "host_listActivity",
        "input": {}
      },
      {
        "name": "hostListActivity",
        "tool": "host_listActivity",
        "input": {}
      }
    ]
  },
  "id": "app_bench_mshfkhri"
}
