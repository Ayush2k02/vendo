{
  "format": "vendo/app@1",
  "name": "Client Directory",
  "tree": {
    "formatVersion": "vendo-genui/v2",
    "root": "app",
    "nodes": [
      {
        "id": "app",
        "component": "Stack",
        "source": "prewired",
        "children": [
          "group-0"
        ]
      },
      {
        "id": "group-0",
        "component": "Surface",
        "source": "prewired",
        "children": [
          "group-0-title",
          "group-0-body"
        ]
      },
      {
        "id": "group-0-title",
        "component": "Text",
        "source": "prewired",
        "props": {
          "text": "Client Overview",
          "variant": "heading"
        }
      },
      {
        "id": "group-0-body",
        "component": "Stack",
        "source": "prewired",
        "children": [
          "group-0-body-cadencemissingdocshero-1",
          "group-0-body-datatable-1"
        ]
      },
      {
        "id": "group-0-body-cadencemissingdocshero-1",
        "component": "CadenceMissingDocsHero",
        "source": "host",
        "props": {
          "missingCount": {
            "$path": "/dashboard/clientsMissingDocs"
          },
          "clientCount": {
            "$path": "/dashboard/clientsTotal"
          },
          "badgeLabel": "Action Required"
        }
      },
      {
        "id": "group-0-body-datatable-1",
        "component": "DataTable",
        "source": "prewired",
        "props": {
          "rows": {
            "$path": "/clients"
          },
          "columns": [
            {
              "key": "businessName",
              "label": "Client"
            },
            {
              "key": "contactName",
              "label": "Contact"
            },
            {
              "key": "entityType",
              "label": "Entity Type"
            },
            {
              "key": "assignee.name",
              "label": "Assigned Staff"
            },
            {
              "key": "status",
              "label": "Status"
            },
            {
              "key": "filingDeadline",
              "label": "Filing Deadline",
              "format": "date"
            }
          ],
          "filterableBy": [
            "status",
            "entityType"
          ],
          "searchable": true,
          "emptyState": "No clients found"
        }
      }
    ],
    "queries": [
      {
        "name": "dashboard",
        "tool": "host_getDashboard",
        "input": {}
      },
      {
        "name": "clients",
        "tool": "host_listClients",
        "input": {}
      }
    ]
  },
  "id": "app_bench_mshfl6um"
}
