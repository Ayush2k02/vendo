{
  "format": "vendo/app@1",
  "name": "Spending & Budget Insights",
  "tree": {
    "formatVersion": "vendo-genui/v2",
    "root": "app",
    "nodes": [
      {
        "id": "app",
        "component": "Stack",
        "source": "prewired",
        "children": [
          "tabs"
        ]
      },
      {
        "id": "tabs",
        "component": "Tabs",
        "source": "prewired",
        "props": {
          "tabs": [
            {
              "value": "Budgets",
              "label": "Budgets"
            },
            {
              "value": "Cut Back",
              "label": "Cut Back"
            }
          ],
          "value": "Budgets"
        },
        "children": [
          "tab-0",
          "tab-1"
        ]
      },
      {
        "id": "tab-0",
        "component": "Stack",
        "source": "prewired",
        "children": [
          "group-0"
        ]
      },
      {
        "id": "tab-1",
        "component": "Stack",
        "source": "prewired",
        "children": [
          "group-1"
        ]
      },
      {
        "id": "group-0",
        "component": "Surface",
        "source": "prewired",
        "children": [
          "group-0-title",
          "group-0-body"
        ]
      },
      {
        "id": "group-0-title",
        "component": "Text",
        "source": "prewired",
        "props": {
          "text": "Spending vs Budget",
          "variant": "heading"
        }
      },
      {
        "id": "group-0-body",
        "component": "Grid",
        "source": "prewired",
        "props": {
          "columns": 2
        },
        "children": [
          "group-0-body-maplespendingdonut-1",
          "group-0-body-datatable-1"
        ]
      },
      {
        "id": "group-0-body-maplespendingdonut-1",
        "component": "MapleSpendingDonut",
        "source": "host",
        "props": {
          "slices": {
            "$path": "/hostGetSpendingInsights"
          }
        }
      },
      {
        "id": "group-0-body-datatable-1",
        "component": "DataTable",
        "source": "prewired",
        "props": {
          "rows": {
            "$path": "/hostGetBudgets"
          },
          "columns": [
            {
              "key": "category",
              "label": "Category"
            },
            {
              "key": "spent",
              "label": "Spend-to-Date",
              "format": "money",
              "align": "end"
            },
            {
              "key": "limit",
              "label": "Budget Limit",
              "format": "money",
              "align": "end"
            }
          ],
          "emptyState": "No budget data available"
        }
      },
      {
        "id": "group-1",
        "component": "Surface",
        "source": "prewired",
        "children": [
          "group-1-title",
          "group-1-body"
        ]
      },
      {
        "id": "group-1-title",
        "component": "Text",
        "source": "prewired",
        "props": {
          "text": "Recurring Charges & Subscriptions",
          "variant": "heading"
        }
      },
      {
        "id": "group-1-body",
        "component": "Stack",
        "source": "prewired",
        "children": [
          "group-1-body-stat-1",
          "group-1-body-datatable-1"
        ]
      },
      {
        "id": "group-1-body-stat-1",
        "component": "Stat",
        "source": "prewired",
        "props": {
          "label": "Total monthly recurring charges committed",
          "value": {
            "$expr": "sum(hostGetRecurringInsights.amount)"
          },
          "format": "money"
        }
      },
      {
        "id": "group-1-body-datatable-1",
        "component": "DataTable",
        "source": "prewired",
        "props": {
          "rows": {
            "$path": "/hostGetRecurringInsights"
          },
          "columns": [
            {
              "key": "merchant",
              "label": "Merchant"
            },
            {
              "key": "category",
              "label": "Category"
            },
            {
              "key": "cadence",
              "label": "Cadence"
            },
            {
              "key": "amount",
              "label": "Amount",
              "format": "money"
            },
            {
              "key": "nextDate",
              "label": "Next Billing Date",
              "format": "date"
            }
          ],
          "filterableBy": [
            "category",
            "cadence"
          ],
          "searchable": true,
          "emptyState": "No recurring charges or active subscriptions found"
        }
      }
    ],
    "queries": [
      {
        "name": "budgets",
        "tool": "host_getBudgets",
        "input": {}
      },
      {
        "name": "spending",
        "tool": "host_getSpendingInsights",
        "input": {}
      },
      {
        "name": "recurring",
        "tool": "host_getRecurringInsights",
        "input": {}
      },
      {
        "name": "hostGetRecurringInsights",
        "tool": "host_getRecurringInsights",
        "input": {}
      },
      {
        "name": "hostGetSpendingInsights",
        "tool": "host_getSpendingInsights",
        "input": {}
      },
      {
        "name": "hostGetBudgets",
        "tool": "host_getBudgets",
        "input": {}
      }
    ]
  },
  "id": "app_bench_msh9r1pj"
}
