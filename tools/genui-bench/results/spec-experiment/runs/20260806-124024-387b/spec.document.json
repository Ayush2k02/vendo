{
  "format": "vendo/app@1",
  "id": "app_bench_spec_0f73a2d7",
  "name": "30-Day Filing Deadline Board",
  "ui": "tree",
  "tree": {
    "formatVersion": "vendo-genui/v2",
    "root": "app",
    "nodes": [
      {
        "id": "app",
        "component": "Stack",
        "source": "prewired",
        "props": {
          "gap": 16
        },
        "children": [
          "title",
          "grid-1",
          "piece-3"
        ]
      },
      {
        "id": "title",
        "component": "Text",
        "source": "prewired",
        "props": {
          "text": "30-Day Filing Deadline Board",
          "variant": "heading"
        }
      },
      {
        "id": "piece-0",
        "component": "Stat",
        "source": "prewired",
        "props": {
          "label": "Nearest Filing Deadline",
          "tone": "danger",
          "value": {
            "$path": "/q0/nearestDeadline"
          }
        }
      },
      {
        "id": "piece-1",
        "component": "Stat",
        "source": "prewired",
        "props": {
          "label": "Clients Missing Documents",
          "value": {
            "$path": "/q0/clientsMissingDocs"
          }
        }
      },
      {
        "id": "piece-2",
        "component": "Stat",
        "source": "prewired",
        "props": {
          "label": "Total Documents Outstanding",
          "value": {
            "$path": "/q0/documentsOutstanding"
          }
        }
      },
      {
        "id": "piece-3",
        "component": "DataTable",
        "source": "prewired",
        "props": {
          "caption": "Client Filing Deadlines & Missing Documentation",
          "sortBy": "filingDeadline asc",
          "searchable": true,
          "filterableBy": [
            "status",
            "entityType",
            "assignee.name"
          ],
          "columns": [
            {
              "key": "businessName",
              "label": "Client Name"
            },
            {
              "key": "entityType",
              "label": "Entity Type"
            },
            {
              "key": "filingDeadline",
              "label": "Filing Deadline"
            },
            {
              "key": "status",
              "label": "Status"
            },
            {
              "key": "progress.received",
              "label": "Docs Received"
            },
            {
              "key": "progress.total",
              "label": "Docs Needed"
            },
            {
              "key": "missingDocKinds",
              "label": "Missing Document Types"
            },
            {
              "key": "assignee.name",
              "label": "Assigned Staff"
            }
          ],
          "emptyState": "No upcoming deadlines found for the selected view.",
          "rows": {
            "$path": "/q1"
          }
        }
      },
      {
        "id": "grid-1",
        "component": "Grid",
        "source": "prewired",
        "props": {
          "columns": 3,
          "gap": 12
        },
        "children": [
          "piece-0",
          "piece-1",
          "piece-2"
        ]
      }
    ],
    "queries": [
      {
        "name": "q0",
        "tool": "host_getDashboard"
      },
      {
        "name": "q1",
        "tool": "host_listDeadlines"
      }
    ]
  }
