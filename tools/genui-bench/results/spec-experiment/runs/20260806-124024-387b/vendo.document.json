{
  "format": "vendo/app@1",
  "name": "30-Day Deadline Board",
  "tree": {
    "formatVersion": "vendo-genui/v2",
    "root": "root",
    "nodes": [
      {
        "id": "root",
        "component": "Stack",
        "source": "prewired",
        "children": [
          "tabs"
        ]
      },
      {
        "id": "tabs",
        "component": "Tabs",
        "source": "prewired",
        "props": {
          "tabs": [
            {
              "value": "Upcoming Deadlines",
              "label": "Upcoming Deadlines"
            }
          ],
          "value": "Upcoming Deadlines"
        },
        "children": [
          "tab-0"
        ]
      },
      {
        "id": "tab-0",
        "component": "Stack",
        "source": "prewired",
        "children": [
          "group-0",
          "group-1"
        ]
      },
      {
        "id": "group-0",
        "component": "Surface",
        "source": "prewired",
        "children": [
          "group-0-title",
          "group-0-body"
        ]
      },
      {
        "id": "group-0-title",
        "component": "Text",
        "source": "prewired",
        "props": {
          "text": "30-Day Overview",
          "variant": "heading"
        }
      },
      {
        "id": "group-0-body",
        "component": "Grid",
        "source": "prewired",
        "props": {
          "columns": 2
        },
        "children": [
          "group-0-body-cadencemissingdocshero-1",
          "group-0-body-stat-1"
        ]
      },
      {
        "id": "group-0-body-cadencemissingdocshero-1",
        "component": "CadenceMissingDocsHero",
        "source": "host",
        "props": {
          "missingCount": {
            "$path": "/dashboard/clientsMissingDocs"
          },
          "clientCount": {
            "$path": "/dashboard/clientsTotal"
          },
          "badgeLabel": "Action Required"
        }
      },
      {
        "id": "group-0-body-stat-1",
        "component": "Stat",
        "source": "prewired",
        "props": {
          "label": {
            "$path": "/dashboard/nearestDeadlineClient/businessName"
          },
          "value": {
            "$path": "/dashboard/nearestDeadline"
          },
          "format": "date"
        }
      },
      {
        "id": "group-1",
        "component": "Surface",
        "source": "prewired",
        "children": [
          "group-1-title",
          "group-1-body"
        ]
      },
      {
        "id": "group-1-title",
        "component": "Text",
        "source": "prewired",
        "props": {
          "text": "Filing Schedule (Next 30 Days)",
          "variant": "heading"
        }
      },
      {
        "id": "group-1-body",
        "component": "Stack",
        "source": "prewired",
        "children": [
          "group-1-body-datatable-1"
        ]
      },
      {
        "id": "group-1-body-datatable-1",
        "component": "DataTable",
        "source": "prewired",
        "props": {
          "rows": {
            "$path": "/deadlines"
          },
          "columns": [
            {
              "key": "filingDeadline",
              "label": "Deadline Date",
              "format": "date"
            },
            {
              "key": "businessName",
              "label": "Client Name"
            },
            {
              "key": "missingDocKinds",
              "label": "Missing Document Kinds"
            },
            {
              "key": "progress",
              "label": "Document Progress"
            }
          ],
          "sortBy": "filingDeadline asc",
          "searchable": true,
          "paginate": 10,
          "emptyState": "No upcoming filing deadlines found for the next 30 days."
        }
      }
    ],
    "queries": [
      {
        "name": "deadlines",
        "tool": "host_listDeadlines",
        "input": {}
      },
      {
        "name": "dashboard",
        "tool": "host_getDashboard",
        "input": {}
      }
    ]
  },
  "id": "app_bench_msh6e94c"
}
