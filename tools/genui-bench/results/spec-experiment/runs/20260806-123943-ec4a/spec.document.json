{
  "format": "vendo/app@1",
  "id": "app_bench_spec_2f2954d1",
  "name": "Client Overview & Document Status",
  "ui": "tree",
  "tree": {
    "formatVersion": "vendo-genui/v2",
    "root": "app",
    "nodes": [
      {
        "id": "app",
        "component": "Stack",
        "source": "prewired",
        "props": {
          "gap": 16
        },
        "children": [
          "title",
          "grid-1",
          "piece-3",
          "piece-4",
          "piece-4-actions"
        ]
      },
      {
        "id": "title",
        "component": "Text",
        "source": "prewired",
        "props": {
          "text": "Client Overview & Document Status",
          "variant": "heading"
        }
      },
      {
        "id": "piece-0",
        "component": "Stat",
        "source": "prewired",
        "props": {
          "label": "Total Active Clients",
          "value": {
            "$path": "/q0/clientsTotal"
          }
        }
      },
      {
        "id": "piece-1",
        "component": "Stat",
        "source": "prewired",
        "props": {
          "label": "Documents Received",
          "value": {
            "$path": "/q0/documentsReceived"
          }
        }
      },
      {
        "id": "piece-2",
        "component": "Stat",
        "source": "prewired",
        "props": {
          "label": "Documents Outstanding",
          "tone": "danger",
          "value": {
            "$path": "/q0/documentsOutstanding"
          }
        }
      },
      {
        "id": "piece-3",
        "component": "BarChart",
        "source": "prewired",
        "props": {
          "xKey": "businessName",
          "series": [
            {
              "key": "progress.received",
              "label": "Received Docs"
            },
            {
              "key": "progress.total",
              "label": "Total Required Docs"
            }
          ],
          "horizontal": true,
          "height": 300,
          "emptyState": "No client data available",
          "data": {
            "$path": "/q1"
          }
        }
      },
      {
        "id": "grid-1",
        "component": "Grid",
        "source": "prewired",
        "props": {
          "columns": 3,
          "gap": 12
        },
        "children": [
          "piece-0",
          "piece-1",
          "piece-2"
        ]
      },
      {
        "id": "piece-4",
        "component": "DataTable",
        "source": "prewired",
        "props": {
          "caption": "Client Breakdown — Note: Revenue data is not tracked in this system; showing document collection progress and deadline status.",
          "columns": [
            {
              "key": "businessName",
              "label": "Client Name"
            },
            {
              "key": "entityType",
              "label": "Entity Type"
            },
            {
              "key": "status",
              "label": "Status"
            },
            {
              "key": "progress.received",
              "label": "Docs Received"
            },
            {
              "key": "progress.total",
              "label": "Total Required"
            },
            {
              "key": "filingDeadline",
              "label": "Filing Deadline"
            },
            {
              "key": "assignee.name",
              "label": "Assigned Staff"
            }
          ],
          "searchable": true,
          "filterableBy": [
            "status",
            "entityType"
          ],
          "paginate": 10,
          "rows": {
            "$path": "/q1"
          }
        }
      },
      {
        "id": "piece-4-actions",
        "component": "Row",
        "source": "prewired",
        "props": {
          "gap": 8
        },
        "children": [
          "piece-4-action-0"
        ]
      },
      {
        "id": "piece-4-action-0",
        "component": "Button",
        "source": "prewired",
        "props": {
          "label": "View Client Details",
          "onClick": {
            "$action": "host_getClient",
            "payload": {
              "id": "cl_rivera"
            }
          }
        }
      }
    ],
    "queries": [
      {
        "name": "q0",
        "tool": "host_getDashboard"
      },
      {
        "name": "q1",
        "tool": "host_listClients"
      }
    ]
  }
