          "variant": "heading"
        }
      },
      {
        "id": "piece-0",
        "component": "Stat",
        "source": "prewired",
        "props": {
          "label": "Tax Documents Received",
          "tone": "accent",
          "value": {
            "$path": "/q0/documentsReceived"
          }
        }
      },
      {
        "id": "piece-1",
        "component": "Stat",
        "source": "prewired",
        "props": {
