{
  "format": "vendo/app@1",
  "id": "app_bench_spec_00387abb",
  "name": "Spending Analysis & Budget Cutbacks",
  "ui": "tree",
  "tree": {
    "formatVersion": "vendo-genui/v2",
    "root": "app",
    "nodes": [
      {
        "id": "app",
        "component": "Stack",
        "source": "prewired",
        "props": {
          "gap": 16
        },
        "children": [
          "title",
          "piece-0",
          "piece-1",
          "piece-2"
        ]
      },
      {
        "id": "title",
        "component": "Text",
        "source": "prewired",
        "props": {
          "text": "Spending Analysis & Budget Cutbacks",
          "variant": "heading"
        }
      },
      {
        "id": "piece-0",
        "component": "DonutChart",
        "source": "prewired",
        "props": {
          "categoryKey": "category",
          "valueKey": "amount",
          "format": "money",
          "data": {
            "$path": "/q0"
          }
        }
      },
      {
        "id": "piece-1",
        "component": "DataTable",
        "source": "prewired",
        "props": {
          "caption": "Budgets vs. Current Spending",
          "columns": [
            {
              "key": "category",
              "label": "Category"
            },
            {
              "key": "spent",
              "label": "Spent",
              "format": "money"
            },
            {
              "key": "limit",
              "label": "Budget Limit",
              "format": "money"
            }
          ],
          "sortBy": "spent desc",
          "rows": {
            "$path": "/q1"
          }
        }
      },
      {
        "id": "piece-2",
        "component": "DataTable",
        "source": "prewired",
        "props": {
          "caption": "Recurring Charges & Subscriptions to Review for Cutbacks",
          "columns": [
            {
              "key": "merchant",
              "label": "Merchant"
            },
            {
              "key": "category",
              "label": "Category"
            },
            {
              "key": "cadence",
              "label": "Frequency"
            },
            {
              "key": "nextDate",
              "label": "Next Date"
            },
            {
              "key": "amount",
              "label": "Amount",
              "format": "money"
            }
          ],
          "sortBy": "amount desc",
          "rows": {
            "$path": "/q2"
          }
        }
      }
    ],
    "queries": [
      {
        "name": "q0",
        "tool": "host_getSpendingInsights"
      },
      {
        "name": "q1",
        "tool": "host_getBudgets"
      },
      {
        "name": "q2",
        "tool": "host_getRecurringInsights"
      }
    ]
  }
}
